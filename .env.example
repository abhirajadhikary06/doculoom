# Flask
SECRET_KEY=change-me-in-production-super-secret-key-32chars
FLASK_ENV=development
PORT=5000

# Neon Postgres (multi-tenant metadata, users, conversations)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Qdrant (local or cloud) — hybrid dense + sparse
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=doculoom_chunks

# Groq LLM
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Auth / multi-tenant
JWT_SECRET=another-super-secret-jwt-key-32chars
JWT_EXPIRE_HOURS=72

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=8
RERANK_TOP_K=4

# Upload / OCR
MAX_UPLOAD_MB=25
OCR_SPACE_API_KEY=
OCR_SPACE_URL=https://api.ocr.space/parse/image

# Optional Redis
REDIS_URL=redis://localhost:6379/0

# App
CORPUS_DIR=./corpus
UPLOAD_DIR=./uploads
DEFAULT_TENANT=campus
HISTORY_TURNS=10
HISTORY_TOKEN_BUDGET=4000
