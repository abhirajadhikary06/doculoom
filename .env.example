# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-super-secret-key-32chars
FLASK_ENV=development
PORT=5000

# ── Neon Postgres (multi-tenant metadata, users, conversations) ───────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Qdrant (local or cloud) — hybrid dense + sparse ──────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=doculoom_chunks

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Auth / multi-tenant ───────────────────────────────────────────────────────
JWT_SECRET=another-super-secret-jwt-key-32chars
JWT_EXPIRE_HOURS=72

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=8
RERANK_TOP_K=4

# ── Upload / OCR ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
OCR_SPACE_API_KEY=
OCR_SPACE_URL=https://api.ocr.space/parse/image

# ── Optional Redis (rate limiter) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
CORPUS_DIR=./corpus
UPLOAD_DIR=./uploads
DEFAULT_TENANT=campus
HISTORY_TURNS=10
HISTORY_TOKEN_BUDGET=4000

# ── Credits ───────────────────────────────────────────────────────────────────
MAX_CREDITS=50
CREDITS_PER_ASK=1
CREDITS_PER_INGEST=5

# ════════════════════════════════════════════════════════════════════════════
# INTELLIGENCE ENGINE — New variables (v2)
# ════════════════════════════════════════════════════════════════════════════

# ── Feature A: Temporal Knowledge Engine ─────────────────────────────────────
# Minimum confidence to auto-record a supersession relationship
TEMPORAL_SUPERSESSION_CONFIDENCE=0.65

# ── Feature B: Evidence Verification ─────────────────────────────────────────
# Enable/disable claim-level verification on /api/ask/v2 responses
EVIDENCE_VERIFY_CLAIMS=true
# Maximum number of claims to verify per answer (LLM calls = claims × 1)
EVIDENCE_MAX_CLAIMS=12

# ── Feature C: Adaptive Retrieval Planner ────────────────────────────────────
# Use query-adaptive strategy instead of always running hybrid search
ADAPTIVE_RETRIEVAL=true
# How much weight trust score has in the final passage ranking blend (0–1)
TRUST_RERANK_WEIGHT=0.15

# ── Feature F: Context-Aware Semantic Cache ──────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity threshold to reuse a cached answer (0.85–0.98 recommended)
CACHE_SEMANTIC_THRESHOLD=0.92
# Cache entry TTL in hours
CACHE_TTL_HOURS=24
# Maximum cache entries per tenant before oldest are evicted
MAX_CACHE_ENTRIES=1000

# ── Feature G: Self-Healing Document Ingestion ───────────────────────────────
# Minimum fraction of pages that must have extractable text (0–1)
IQ_MIN_COVERAGE=0.5
# Minimum average characters per page to consider non-empty
IQ_MIN_CHARS_PAGE=50
# Maximum ratio of empty chunks before flagging (0–1)
IQ_MAX_EMPTY_RATIO=0.3
# Overall quality score below this triggers quarantine (0–1)
IQ_MIN_QUALITY=0.4

# ── Feature J: Query Decomposition Engine ────────────────────────────────────
DECOMPOSITION_ENABLED=true
# Maximum sub-questions to generate per complex query
DECOMPOSITION_MAX_SUBQUESTIONS=4

# ── Feature L: Knowledge Expiration Engine ───────────────────────────────────
# Days after creation before flagging a document for review (if no explicit dates)
EXPIRY_REVIEW_DAYS=365

# ── Feature M: Retrieval Drift Detection ─────────────────────────────────────
# Recall drop fraction that triggers a drift alert (e.g. 0.15 = 15% drop)
DRIFT_ALERT_THRESHOLD=0.15
# Automatically run drift evaluation after every document ingest (can be slow)
DRIFT_ON_INGEST=false

# ── Feature P: Information Gap Discovery ─────────────────────────────────────
# Cosine similarity threshold to merge unanswered questions into same gap cluster
GAP_CLUSTER_THRESHOLD=0.80

# ── Provenance / Reproducibility ─────────────────────────────────────────────
# Store full execution records (query log + evidence snapshots) for every /api/ask/v2 call
PROVENANCE_ENABLED=true

# ── Document Impact Analysis ──────────────────────────────────────────────────
# Run entity extraction + conflict detection + supersession detection after ingest
IMPACT_ANALYSIS_ENABLED=true
# Run impact analysis in a background thread (recommended — keeps upload API fast)
IMPACT_ANALYSIS_BACKGROUND=true
